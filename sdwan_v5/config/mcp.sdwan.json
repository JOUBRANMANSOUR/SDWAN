{
  "mcpServers": {
    "sdwan": {
      "type": "stdio",
      "command": "/mnt/data/sdwan-management-venv/bin/python",
      "args": [
        "-m",
        "sdwan_v5.sdwan_mcp.server"
      ],
      "env": {
        "PYTHONPATH": "/mnt/data/sdwan-lab",
        "SDWAN_PROJECT_ROOT": "/mnt/data/sdwan-lab/sdwan_v5",
        "SDWAN_AGENT_CONTEXT_TOKEN": "${SDWAN_AGENT_CONTEXT_TOKEN}",
        "SDWAN_CHAT_SESSION_ID": "${SDWAN_CHAT_SESSION_ID}",
        "SDWAN_MANAGEMENT_SECRET": "${SDWAN_MANAGEMENT_SECRET}",
        "SDWAN_AGENT_CONTEXT_AUDIENCE": "sdwan-mcp-stdio",
        "SDWAN_CHAT_MESSAGE_ID": "${SDWAN_CHAT_MESSAGE_ID}",
        "SDWAN_EVIDENCE_BUNDLE_ID": "${SDWAN_EVIDENCE_BUNDLE_ID}"
      }
    }
  }
}
