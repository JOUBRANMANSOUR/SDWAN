graph sdwan_v5 {
  graph [rankdir="LR", bgcolor="white", pad="0.25", nodesep="0.35", ranksep="1.0", splines="polyline", fontname="Arial", label="SD-WAN v5 physical topology", labelloc="t", fontsize="20"];
  node [fontname="Arial", fontsize="10", color="#374151"];
  edge [fontname="Arial", fontsize="9", dir="none"];
  subgraph cluster_management {
    label="Management";
    color="#9ca3af"; style="rounded";
    "mgmtroot" [shape="house", style="filled", fillcolor="#e5e7eb", label="mgmtroot\\ncontroller / services"];
    "mgmtbr" [shape="diamond", style="filled", fillcolor="#e5e7eb", label="mgmtbr"];
  }
  subgraph cluster_hubs {
    label="Dual active-active hubs";
    color="#9ca3af"; style="rounded";
    "hub1" [shape="box", style="rounded,filled", fillcolor="#ede9fe", label="hub1\\nActive-active hub"];
    "hub2" [shape="box", style="rounded,filled", fillcolor="#ede9fe", label="hub2\\nActive-active hub"];
  }
  subgraph cluster_underlay {
    label="Transport underlay";
    color="#9ca3af"; style="rounded";
    "s_mpls" [shape="hexagon", style="filled", fillcolor="#2563eb", fontcolor="white", label="s_mpls\\nMPLS underlay\\n20.0 Mbps; 4.0 ms"];
    "s_bb" [shape="hexagon", style="filled", fillcolor="#16a34a", fontcolor="white", label="s_bb\\nBB underlay\\n50.0 Mbps; 25.0 ms"];
    "s_lte" [shape="hexagon", style="filled", fillcolor="#d97706", fontcolor="white", label="s_lte\\nLTE underlay\\n8.0 Mbps; 60.0 ms"];
  }
  subgraph cluster_branch_node1 {
    label="node1 LAN (10.1.0.0/24)";
    color="#9ca3af"; style="rounded";
    "node1_host" [shape="ellipse", style="filled", fillcolor="#fef3c7", label="node1_host\\nBranch client"];
    "lsw1" [shape="diamond", style="filled", fillcolor="#dbeafe", label="lsw1\\nOpenFlow 1.3\\nDPID 101"];
    "node1" [shape="box", style="rounded,filled", fillcolor="#ede9fe", label="node1\\nEdge router\\nprimary hub1; standby hub2"];
  }
  subgraph cluster_branch_node2 {
    label="node2 LAN (10.2.0.0/24)";
    color="#9ca3af"; style="rounded";
    "node2_host" [shape="ellipse", style="filled", fillcolor="#fef3c7", label="node2_host\\nBranch client"];
    "lsw2" [shape="diamond", style="filled", fillcolor="#dbeafe", label="lsw2\\nOpenFlow 1.3\\nDPID 102"];
    "node2" [shape="box", style="rounded,filled", fillcolor="#ede9fe", label="node2\\nEdge router\\nprimary hub1; standby hub2"];
  }
  subgraph cluster_branch_node3 {
    label="node3 LAN (10.3.0.0/24)";
    color="#9ca3af"; style="rounded";
    "node3_host" [shape="ellipse", style="filled", fillcolor="#fef3c7", label="node3_host\\nBranch client"];
    "lsw3" [shape="diamond", style="filled", fillcolor="#dbeafe", label="lsw3\\nOpenFlow 1.3\\nDPID 103"];
    "node3" [shape="box", style="rounded,filled", fillcolor="#ede9fe", label="node3\\nEdge router\\nprimary hub1; standby hub2"];
  }
  subgraph cluster_branch_node4 {
    label="node4 LAN (10.4.0.0/24)";
    color="#9ca3af"; style="rounded";
    "node4_host" [shape="ellipse", style="filled", fillcolor="#fef3c7", label="node4_host\\nBranch client"];
    "lsw4" [shape="diamond", style="filled", fillcolor="#dbeafe", label="lsw4\\nOpenFlow 1.3\\nDPID 104"];
    "node4" [shape="box", style="rounded,filled", fillcolor="#ede9fe", label="node4\\nEdge router\\nprimary hub2; standby hub1"];
  }
  subgraph cluster_branch_node5 {
    label="node5 LAN (10.5.0.0/24)";
    color="#9ca3af"; style="rounded";
    "node5_host" [shape="ellipse", style="filled", fillcolor="#fef3c7", label="node5_host\\nBranch client"];
    "lsw5" [shape="diamond", style="filled", fillcolor="#dbeafe", label="lsw5\\nOpenFlow 1.3\\nDPID 105"];
    "node5" [shape="box", style="rounded,filled", fillcolor="#ede9fe", label="node5\\nEdge router\\nprimary hub2; standby hub1"];
  }
  subgraph cluster_data_center {
    label="Data Center (10.100.0.0/24)";
    color="#9ca3af"; style="rounded";
    "dcbr" [shape="diamond", style="filled", fillcolor="#e5e7eb", label="dcbr"];
    "dc_app" [shape="component", style="filled", fillcolor="#cffafe", label="dc_app\\nData Center\\n10.100.0.10"];
  }
  subgraph cluster_saas {
    label="Simulated SaaS (198.18.0.0/24)";
    color="#9ca3af"; style="rounded";
    "inetbr" [shape="diamond", style="filled", fillcolor="#e5e7eb", label="inetbr"];
    "saas_nginx" [shape="component", style="filled", fillcolor="#dcfce7", label="saas_nginx\\nNginx SaaS\\n198.18.0.10"];
  }
  "mgmtroot" -- "mgmtbr" [color="#6b7280", style="dashed", label="mgmt-root <-> mgmtbr-root\\n172.30.0.254/24", fontsize="8"];
  "hub1" -- "mgmtbr" [color="#374151", label="hub1-mgmt <-> mgmtbr-h1\\n172.30.0.1/24", fontsize="8"];
  "hub2" -- "mgmtbr" [color="#374151", label="hub2-mgmt <-> mgmtbr-h2\\n172.30.0.2/24", fontsize="8"];
  "node1" -- "mgmtbr" [color="#374151", label="node1-mgmt <-> mgmtbr-n1\\n172.30.0.11/24", fontsize="8"];
  "node2" -- "mgmtbr" [color="#374151", label="node2-mgmt <-> mgmtbr-n2\\n172.30.0.12/24", fontsize="8"];
  "node3" -- "mgmtbr" [color="#374151", label="node3-mgmt <-> mgmtbr-n3\\n172.30.0.13/24", fontsize="8"];
  "node4" -- "mgmtbr" [color="#374151", label="node4-mgmt <-> mgmtbr-n4\\n172.30.0.14/24", fontsize="8"];
  "node5" -- "mgmtbr" [color="#374151", label="node5-mgmt <-> mgmtbr-n5\\n172.30.0.15/24", fontsize="8"];
  "hub1" -- "s_mpls" [color="#2563eb", penwidth="1.8", label="hub1-mpls <-> s_mpls-h1\\n192.168.10.1/24", fontsize="8"];
  "hub1" -- "s_bb" [color="#16a34a", penwidth="1.8", label="hub1-bb <-> s_bb-h1\\n192.168.20.1/24", fontsize="8"];
  "hub1" -- "s_lte" [color="#d97706", penwidth="1.8", label="hub1-lte <-> s_lte-h1\\n192.168.30.1/24", fontsize="8"];
  "hub2" -- "s_mpls" [color="#2563eb", penwidth="1.8", label="hub2-mpls <-> s_mpls-h2\\n192.168.10.2/24", fontsize="8"];
  "hub2" -- "s_bb" [color="#16a34a", penwidth="1.8", label="hub2-bb <-> s_bb-h2\\n192.168.20.2/24", fontsize="8"];
  "hub2" -- "s_lte" [color="#d97706", penwidth="1.8", label="hub2-lte <-> s_lte-h2\\n192.168.30.2/24", fontsize="8"];
  "node1" -- "s_mpls" [color="#2563eb", penwidth="1.8", label="node1-mpls <-> s_mpls-n1\\n192.168.10.11/24", fontsize="8"];
  "node1" -- "s_bb" [color="#16a34a", penwidth="1.8", label="node1-bb <-> s_bb-n1\\n192.168.20.11/24", fontsize="8"];
  "node1" -- "s_lte" [color="#d97706", penwidth="1.8", label="node1-lte <-> s_lte-n1\\n192.168.30.11/24", fontsize="8"];
  "node2" -- "s_mpls" [color="#2563eb", penwidth="1.8", label="node2-mpls <-> s_mpls-n2\\n192.168.10.12/24", fontsize="8"];
  "node2" -- "s_bb" [color="#16a34a", penwidth="1.8", label="node2-bb <-> s_bb-n2\\n192.168.20.12/24", fontsize="8"];
  "node2" -- "s_lte" [color="#d97706", penwidth="1.8", label="node2-lte <-> s_lte-n2\\n192.168.30.12/24", fontsize="8"];
  "node3" -- "s_mpls" [color="#2563eb", penwidth="1.8", label="node3-mpls <-> s_mpls-n3\\n192.168.10.13/24", fontsize="8"];
  "node3" -- "s_bb" [color="#16a34a", penwidth="1.8", label="node3-bb <-> s_bb-n3\\n192.168.20.13/24", fontsize="8"];
  "node3" -- "s_lte" [color="#d97706", penwidth="1.8", label="node3-lte <-> s_lte-n3\\n192.168.30.13/24", fontsize="8"];
  "node4" -- "s_mpls" [color="#2563eb", penwidth="1.8", label="node4-mpls <-> s_mpls-n4\\n192.168.10.14/24", fontsize="8"];
  "node4" -- "s_bb" [color="#16a34a", penwidth="1.8", label="node4-bb <-> s_bb-n4\\n192.168.20.14/24", fontsize="8"];
  "node4" -- "s_lte" [color="#d97706", penwidth="1.8", label="node4-lte <-> s_lte-n4\\n192.168.30.14/24", fontsize="8"];
  "node5" -- "s_mpls" [color="#2563eb", penwidth="1.8", label="node5-mpls <-> s_mpls-n5\\n192.168.10.15/24", fontsize="8"];
  "node5" -- "s_bb" [color="#16a34a", penwidth="1.8", label="node5-bb <-> s_bb-n5\\n192.168.20.15/24", fontsize="8"];
  "node5" -- "s_lte" [color="#d97706", penwidth="1.8", label="node5-lte <-> s_lte-n5\\n192.168.30.15/24", fontsize="8"];
  "node1" -- "lsw1" [color="#374151", label="node1-lan <-> lsw1-r\\n10.1.0.1/24", fontsize="8"];
  "node1_host" -- "lsw1" [color="#374151", label="node1_host-lan <-> lsw1-h\\n10.1.0.10/24", fontsize="8"];
  "node2" -- "lsw2" [color="#374151", label="node2-lan <-> lsw2-r\\n10.2.0.1/24", fontsize="8"];
  "node2_host" -- "lsw2" [color="#374151", label="node2_host-lan <-> lsw2-h\\n10.2.0.10/24", fontsize="8"];
  "node3" -- "lsw3" [color="#374151", label="node3-lan <-> lsw3-r\\n10.3.0.1/24", fontsize="8"];
  "node3_host" -- "lsw3" [color="#374151", label="node3_host-lan <-> lsw3-h\\n10.3.0.10/24", fontsize="8"];
  "node4" -- "lsw4" [color="#374151", label="node4-lan <-> lsw4-r\\n10.4.0.1/24", fontsize="8"];
  "node4_host" -- "lsw4" [color="#374151", label="node4_host-lan <-> lsw4-h\\n10.4.0.10/24", fontsize="8"];
  "node5" -- "lsw5" [color="#374151", label="node5-lan <-> lsw5-r\\n10.5.0.1/24", fontsize="8"];
  "node5_host" -- "lsw5" [color="#374151", label="node5_host-lan <-> lsw5-h\\n10.5.0.10/24", fontsize="8"];
  "hub1" -- "dcbr" [color="#374151", label="hub1-dc <-> dcbr-h1\\n10.100.0.1/24", fontsize="8"];
  "hub2" -- "dcbr" [color="#374151", label="hub2-dc <-> dcbr-h2\\n10.100.0.2/24", fontsize="8"];
  "dc_app" -- "dcbr" [color="#374151", label="dc_app-net <-> dcbr-app\\n10.100.0.10/24", fontsize="8"];
  "saas_nginx" -- "inetbr" [color="#374151", label="saas_nginx-inet <-> inetbr-saas\\n198.18.0.10/24", fontsize="8"];
  "saas_nginx" -- "s_bb" [color="#374151", label="saas-bb <-> s_bb-saas\\n192.168.20.254/24", fontsize="8"];
  "saas_nginx" -- "s_lte" [color="#374151", label="saas-lte <-> s_lte-saas\\n192.168.30.254/24", fontsize="8"];
}
