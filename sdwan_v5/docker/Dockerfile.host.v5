# syntax=docker/dockerfile:1.7
FROM ubuntu:24.04
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl dnsutils iperf3 iproute2 iputils-ping nginx-light openssl \
    python3 python3-yaml tcpdump && rm -rf /var/lib/apt/lists/*
COPY sdwan_v5/nginx/nginx.conf /etc/nginx/nginx.conf
COPY sdwan_v5/nginx/generate_test_certificate.sh /usr/local/bin/generate_test_certificate.sh
COPY sdwan_v5/workloads/saas-test-file.txt /srv/www/sdwan-v5-test-file.txt
COPY sdwan_v5/workloads/http_load.py /opt/sdwan_v5/workloads/http_load.py
COPY sdwan_v5/workloads/saas_service.py /opt/sdwan_v5/workloads/saas_service.py
COPY sdwan_v5/workloads/saas-test-file.txt /srv/www/test-file.bin
RUN chmod +x /usr/local/bin/generate_test_certificate.sh && \
    /usr/local/bin/generate_test_certificate.sh && \
    nginx -t && \
    sha256sum /srv/www/sdwan-v5-test-file.txt > /srv/www/sdwan-v5-test-file.sha256
CMD ["sleep", "infinity"]
