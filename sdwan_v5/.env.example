# SD-WAN v5 read-only management platform
SDWAN_STATE_ROOT=/mnt/data/sdwan-state
SDWAN_TOPOLOGY_CONFIG=/mnt/data/sdwan-lab/sdwan_v5/config/topology.yaml
SDWAN_MANAGEMENT_STATE=/mnt/data/sdwan-state/management
SDWAN_MANAGEMENT_HOST=127.0.0.1
SDWAN_MANAGEMENT_PORT=8090
# Generate a unique local secret; do not commit a real value.
SDWAN_MANAGEMENT_SECRET=replace-with-a-long-random-secret
# Format: username:password:ROLE, separated by commas. Roles: VIEWER, NETWORK_ADMIN, AUDITOR, PLATFORM_ADMIN.
SDWAN_MANAGEMENT_USERS=viewer:change-me:VIEWER,operator:change-me:NETWORK_ADMIN,auditor:change-me:AUDITOR,platform:change-me:PLATFORM_ADMIN
# External agent execution is intentionally disabled. This project never accepts a browser-provided command.
SDWAN_AGENT_COMMAND=
