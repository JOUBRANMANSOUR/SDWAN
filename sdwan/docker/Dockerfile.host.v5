# syntax=docker/dockerfile:1.7
FROM ubuntu:24.04
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl dnsutils ffmpeg iperf3 iproute2 iputils-ping nginx-light openssl \
    python3 python3-pip python3-yaml tcpdump && rm -rf /var/lib/apt/lists/* && \
    python3 -m pip install --break-system-packages --no-cache-dir \
      fastapi==0.115.12 uvicorn==0.33.0 python-multipart==0.0.20
COPY sdwan/nginx/nginx.conf /etc/nginx/nginx.conf
COPY sdwan/nginx/generate_test_certificate.sh /usr/local/bin/generate_test_certificate.sh
COPY sdwan/workloads/saas-test-file.txt /srv/www/sdwan-v5-test-file.txt
COPY sdwan/workloads/http_load.py /opt/sdwan/workloads/http_load.py
COPY sdwan/workloads/backup_service.py /opt/sdwan/workloads/backup_service.py
COPY sdwan/workloads/public_saas_service.py /opt/sdwan/workloads/public_saas_service.py
COPY sdwan/workloads/backup_client.py /opt/sdwan/workloads/backup_client.py
COPY sdwan/workloads/saas_client.py /opt/sdwan/workloads/saas_client.py
COPY sdwan/workloads/rtp_sender.sh /opt/sdwan/workloads/rtp_sender.sh
COPY sdwan/workloads/rtp_receiver.sh /opt/sdwan/workloads/rtp_receiver.sh
COPY sdwan/workloads/rtp-video.sdp /opt/sdwan/workloads/rtp-video.sdp
COPY sdwan/workloads/saas-test-file.txt /srv/www/test-file.bin
RUN chmod +x /usr/local/bin/generate_test_certificate.sh /opt/sdwan/workloads/*.sh /opt/sdwan/workloads/*_client.py && \
    /usr/local/bin/generate_test_certificate.sh && \
    nginx -t && \
    sha256sum /srv/www/sdwan-v5-test-file.txt > /srv/www/sdwan-v5-test-file.sha256
CMD ["sleep", "infinity"]
