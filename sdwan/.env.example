# Read-only SD-WAN v5 Management Gateway. Do not commit a real .env.
SDWAN_PROJECT_ROOT=/mnt/data/sdwan-lab/sdwan
SDWAN_STATE_ROOT=/mnt/data/sdwan-state
SDWAN_TOPOLOGY_CONFIG=/mnt/data/sdwan-lab/sdwan/config/topology.yaml
SDWAN_MANAGEMENT_STATE=/mnt/data/sdwan-state/management
MANAGEMENT_HOST=127.0.0.1
MANAGEMENT_PORT=8090
SDWAN_MANAGEMENT_SECRET=replace-with-a-long-random-secret
SDWAN_MANAGEMENT_USERS=viewer:change-me:VIEWER,operator:change-me:NETWORK_OPERATOR,admin:change-me:ADMINAUTH_ISSUER=local-lab-bootstrap
AUTH_AUDIENCE=sdwan-management
AGENT_CONTEXT_AUDIENCE=sdwan-mcp-stdio
AGENT_CONTEXT_TTL_SECONDS=120
OLLAMA_EXECUTABLE=/usr/local/bin/ollama
OLLAMA_MODEL=gpt-oss:20b-cloud
CLAUDE_EXECUTABLE=/home/joubran/.local/bin/claude
AGENT_HOME=/home/joubran
AGENT_SUBPROCESS_PATH=/home/joubran/.local/bin:/usr/local/bin:/usr/bin:/bin
CLAUDE_TIMEOUT_SECONDS=120
CLAUDE_MAX_OUTPUT_BYTES=262144
CLAUDE_SETTINGS_PATH=/mnt/data/sdwan-lab/sdwan/config/claude.sdwan.settings.json
SDWAN_MCP_CONFIG_PATH=/mnt/data/sdwan-lab/sdwan/config/mcp.sdwan.json
# Do not configure ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, or ANTHROPIC_BASE_URL for this path.
